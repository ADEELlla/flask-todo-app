{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: run locally",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\manage.py",
      "args": [
        "runserver",
        "-h",
